{
    "name": "blkdem/filament-queue-monitor",
    "description": "A lightweight queue monitoring plugin for Filament. Not a replacement for Laravel Horizon.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "queue",
        "monitor",
        "redis",
        "database"
    ],
    "authors": [
        {
            "name": "BlkDem"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/queue": "^10.0 || ^11.0 || ^12.0",
        "illuminate/events": "^10.0 || ^11.0 || ^12.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "filament/filament": "^3.3 || ^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "pestphp/pest": "^2.0 || ^3.0",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "ext-redis": "Required for Redis queue monitoring."
    },
    "autoload": {
        "psr-4": {
            "BlkDem\\FilamentQueueMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlkDem\\FilamentQueueMonitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlkDem\\FilamentQueueMonitor\\FilamentQueueMonitorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
